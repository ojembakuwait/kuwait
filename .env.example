# ---- Database (PostgreSQL) ----
# Local (docker compose up -d db):
DATABASE_URL="postgresql://portal:portal@localhost:5432/investor_portal?schema=public"
# Production (e.g. Neon): use the pooled connection string from your provider, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Security ----
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- App ----
# Public base URL (used for password-reset links). On Vercel set to your domain.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="CARDONE"

# ---- Notes ----
# No live email/payments/e-signature/identity provider is required to run.
# Documents are generated on the fly and the email adapter writes to a local
# folder / server logs, so no writable persistent filesystem is needed.
