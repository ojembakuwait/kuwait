# ---- Database ----
# Default (SQLite, no services required):
DATABASE_URL="file:./dev.db"
# PostgreSQL alternative (start with: docker compose up -d db), then set
# provider = "postgresql" in prisma/schema.prisma and use:
# DATABASE_URL="postgresql://portal:portal@localhost:5432/investor_portal?schema=public"

# ---- Security ----
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- App ----
APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="CARDONE"

# ---- Storage ----
# Local directory for documents + dev mail inbox. Defaults to ./storage.
# STORAGE_DIR="./storage"

# ---- Optional live providers (leave unset for local-only operation) ----
# No live email/payments/signature/identity providers are required to run
# locally. Integrate them only when you supply credentials; keep secrets here
# (server-side) and out of source control.
